# ─────────────────────────────────────────────
# AutoNG Server — Environment Variables
# Copy this file to .env and fill in all values
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Supabase ──────────────────────────────────
# Get these from your Supabase project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Storage bucket name (create in Supabase Storage panel)
SUPABASE_STORAGE_BUCKET=car-images

# ── Paystack ──────────────────────────────────
# Get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Nodemailer / Email ─────────────────────────
# SMTP settings — works with Gmail, Zoho, Mailgun, etc.
# For Gmail: use an App Password (not your main password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here
EMAIL_FROM="AutoNG <no-reply@autong.ng>"

# ── Twilio WhatsApp ────────────────────────────
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
# Twilio WhatsApp sandbox number (or approved number)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Admin ─────────────────────────────────────
# A strong secret token for admin API access
ADMIN_TOKEN=change-this-to-a-long-random-secret
# Admin login password (shown on /admin.html)
ADMIN_PASSWORD=your-admin-password

# ── Frontend (for Paystack inline) ────────────
# This is the PUBLIC key — safe to expose to browser
NEXT_PUBLIC_PAYSTACK_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
